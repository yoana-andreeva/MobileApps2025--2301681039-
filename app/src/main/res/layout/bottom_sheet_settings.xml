<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="serif"
        android:text="Настройки"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Тема"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ Светла"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 Тъмна"
            style="@style/Widget.Material3.Chip.Filter" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Напомняне преди срок"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipReminder1h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 час"
            style="@style/Widget.Material3.Chip.Filter"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipReminder3h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 часа"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipReminder1d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 ден"
            style="@style/Widget.Material3.Chip.Filter" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearOldTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Изчисти стари задачи"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>